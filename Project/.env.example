# VitalRepo Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# (Optional) GitHub Personal Access Token
# Without a token, GitHub REST API allows 60 requests/hour per IP.
# With a token, rate limit expands to 5,000 requests/hour.
# Classic token: requires no special scopes for public repositories.
GITHUB_TOKEN=

# Local Ollama AI Service
# VitalRepo uses a local open-weight model for 100% private analysis.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default model: Qwen 2.5 3B (Apache 2.0 license)
OLLAMA_MODEL=qwen2.5:3b

# Backend Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL_SECONDS=900

# Default observation window in days (30, 90, or 180)
DEFAULT_PERIOD_DAYS=90
